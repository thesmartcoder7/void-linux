#!/bin/sh
# Install as /etc/sv/minlogin/run. This service owns the X server and greeter.
set -eu

DISPLAY=:0
ROOT_AUTH=/run/minlogin/Xauthority
USER_AUTH=/run/minlogin-user.Xauthority
USER_NAME="samuel" # Keep in sync with MINLOGIN_USER in config.h.

mkdir -p /run/minlogin
chmod 700 /run/minlogin
rm -f "$ROOT_AUTH" "$USER_AUTH"

command -v Xorg >/dev/null 2>&1 || { echo 'minlogin: Xorg is not installed' >&2; exit 1; }
command -v xauth >/dev/null 2>&1 || { echo 'minlogin: xauth is not installed' >&2; exit 1; }
command -v mcookie >/dev/null 2>&1 || { echo 'minlogin: mcookie is not installed' >&2; exit 1; }

cookie=$(mcookie)
xauth -f "$ROOT_AUTH" add "$DISPLAY" MIT-MAGIC-COOKIE-1 "$cookie"
chmod 600 "$ROOT_AUTH"
cp "$ROOT_AUTH" "$USER_AUTH"
chown "$USER_NAME" "$USER_AUTH"
chmod 600 "$USER_AUTH"
unset cookie

if [ -S /tmp/.X11-unix/X0 ]; then
    echo 'minlogin: X display :0 already exists; refusing to compete with another display manager' >&2
    exit 1
fi

Xorg "$DISPLAY" vt7 -nolisten tcp -auth "$ROOT_AUTH" -noreset &
xpid=$!
cleanup() {
    kill "$xpid" 2>/dev/null || true
    wait "$xpid" 2>/dev/null || true
    rm -f "$ROOT_AUTH" "$USER_AUTH"
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM

# Wait up to 10 seconds for the server's local socket.
i=0
while [ ! -S /tmp/.X11-unix/X0 ]; do
    if ! kill -0 "$xpid" 2>/dev/null; then
        echo 'minlogin: Xorg exited before becoming ready' >&2
        exit 1
    fi
    i=$((i + 1))
    [ "$i" -lt 100 ] || { echo 'minlogin: timed out waiting for Xorg' >&2; exit 1; }
    sleep 0.1
done

# Keep the service as the supervisor; if the greeter exits, runit restarts it.
while :; do
    DISPLAY="$DISPLAY" XAUTHORITY="$ROOT_AUTH" /usr/local/bin/minlogin || true
    if ! kill -0 "$xpid" 2>/dev/null; then
        echo 'minlogin: Xorg exited; restarting service' >&2
        exit 1
    fi
    sleep 1
done
